def recommend_projects(interests, skills, career):
    recommendations = []

    for project in project_topics:
        score = 0
        reasons = []

        # Interest matching
        interest_matches = set(interests) & set(project["interests"])

        if interest_matches:
            score += len(interest_matches) * 3
            reasons.append(
                "Matches your interests: " +
                ", ".join(interest_matches)
            )

        # Skill matching
        skill_matches = set(skills) & set(project["skills"])

        if skill_matches:
            score += len(skill_matches) * 2
            reasons.append(
                "Uses your skills: " +
                ", ".join(skill_matches)
            )

        # Career matching
        if career in project["career"]:
            score += 5
            reasons.append(
                "Good match for your career goal"
            )

        recommendations.append({
            "project": project,
            "score": score,
            "reasons": reasons
        })

    recommendations.sort(
        key=lambda x: x["score"],
        reverse=True
    )

    return recommendations


